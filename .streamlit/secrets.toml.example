# Salin file ini menjadi ".streamlit/secrets.toml" (hapus akhiran .example)
# lalu isi nilai di bawah dengan isi file JSON Service Account dari Google Cloud.
# JANGAN pernah membagikan atau meng-commit file secrets.toml ke Git/publik.

sheet_id = "TEMPEL_ID_ATAU_URL_GOOGLE_SHEET_DI_SINI"

[gcp_service_account]
type = "service_account"
project_id = "nama-project-anda"
private_key_id = "isi-dari-file-json"
private_key = "-----BEGIN PRIVATE KEY-----\nISI_PRIVATE_KEY_ANDA\n-----END PRIVATE KEY-----\n"
client_email = "nama-akun@nama-project.iam.gserviceaccount.com"
client_id = "isi-dari-file-json"
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "https://www.googleapis.com/robot/v1/metadata/x509/nama-akun%40nama-project.iam.gserviceaccount.com"
